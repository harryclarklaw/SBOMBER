<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Open-source licence risk report{% if sbom.document_name %} — {{ sbom.document_name }}{% endif %}</title>
<style>
  :root {
    --fg: #1a1a1a; --muted: #5a5a5a; --line: #d9d9d9; --bg: #ffffff;
    --blocked-bg: #fbe3e3; --blocked-fg: #8a1f1f;
    --review-bg: #fdf3da; --review-fg: #8a5a00;
    --allowed-bg: #e3f3e6; --allowed-fg: #1f6b2e;
    --accent: #1f3a5f;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--fg); background: var(--bg); line-height: 1.5;
    max-width: 1080px; margin: 0 auto; padding: 2rem 1.25rem 4rem;
  }
  h1 { font-size: 1.7rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.2rem; margin: 2rem 0 .6rem; border-bottom: 2px solid var(--line); padding-bottom: .3rem; }
  .subtitle { color: var(--muted); margin: 0 0 1.25rem; }
  .disclaimer {
    border: 1px solid var(--review-fg); background: var(--review-bg); color: #4a3500;
    padding: .85rem 1rem; border-radius: 6px; margin: 1rem 0; font-size: .92rem;
  }
  .posture-banner {
    display: inline-block; padding: .5rem .9rem; border-radius: 6px; font-weight: 700;
    font-size: 1.05rem; letter-spacing: .02em;
  }
  dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: .2rem 1rem; margin: .5rem 0; }
  dl.meta dt { color: var(--muted); }
  dl.meta dd { margin: 0; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; font-size: .9rem; }
  th, td { border: 1px solid var(--line); padding: .45rem .55rem; text-align: left; vertical-align: top; }
  th { background: #f3f5f8; }
  td.num, th.num { text-align: right; }
  .badge {
    display: inline-block; padding: .08rem .5rem; border-radius: 999px;
    font-size: .8rem; font-weight: 700; white-space: nowrap;
  }
  .badge.blocked, .posture-banner.blocked { background: var(--blocked-bg); color: var(--blocked-fg); }
  .badge.review, .posture-banner.review { background: var(--review-bg); color: var(--review-fg); }
  .badge.allowed, .posture-banner.allowed { background: var(--allowed-bg); color: var(--allowed-fg); }
  code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .85em; }
  .muted { color: var(--muted); }
  ul.tight li { margin: .35rem 0; }
  .applies { color: var(--muted); font-size: .85rem; }
  footer { margin-top: 3rem; color: var(--muted); font-size: .82rem; border-top: 1px solid var(--line); padding-top: 1rem; }
</style>
</head>
<body>

<h1>Open-source licence risk report</h1>
<p class="subtitle">Generated by {{ tool.name }} {{ tool.version }} — {{ tool.tagline }}.</p>

<div class="disclaimer"><strong>Disclaimer.</strong> {{ disclaimer }}</div>

<h2>Subject</h2>
<dl class="meta">
  <dt>SBOM</dt><dd>{{ sbom.document_name or "(unnamed)" }} <span class="muted">({{ sbom.format }} {{ sbom.spec_version }}, {{ sbom.component_count }} components)</span></dd>
  {% if sbom.source_path %}<dt>Source file</dt><dd class="mono">{{ sbom.source_path }}</dd>{% endif %}
  {% if sbom.metadata_timestamp %}<dt>SBOM timestamp</dt><dd>{{ sbom.metadata_timestamp }}</dd>{% endif %}
  <dt>Policy</dt><dd>{{ policy.name }} <span class="muted">(version {{ policy.version }})</span></dd>
  {% if policy.source %}<dt>Policy source</dt><dd class="mono">{{ policy.source }}</dd>{% endif %}
</dl>

<h2>Executive summary</h2>
<p><span class="posture-banner {{ summary.overall_posture }}">Overall release posture: {{ summary.overall_posture | posture_label | upper }}</span></p>
<p>{{ summary.interpretation }}</p>
<table>
  <thead><tr><th>Posture</th><th class="num">Components</th></tr></thead>
  <tbody>
    <tr><td><span class="badge blocked">Blocked</span></td><td class="num">{{ summary.counts.blocked }}</td></tr>
    <tr><td><span class="badge review">Review</span></td><td class="num">{{ summary.counts.review }}</td></tr>
    <tr><td><span class="badge allowed">Allowed</span></td><td class="num">{{ summary.counts.allowed }}</td></tr>
    <tr><td><strong>Total</strong></td><td class="num"><strong>{{ summary.counts.total }}</strong></td></tr>
  </tbody>
</table>
<p class="muted">{{ summary.counts.unresolved }} could not be resolved automatically; {{ summary.counts.exceptions_applied }} have a project exception applied.</p>
{% if summary.gate.fail_on %}
<p>Gate (fail on: {{ summary.gate.fail_on | join(", ") }}):
  {% if summary.gate.failed %}<span class="badge blocked">FAILED</span>{% else %}<span class="badge allowed">passed</span>{% endif %}
</p>
{% endif %}

<h2>Risk register</h2>
<table>
  <thead><tr>
    <th>Component</th><th>Version</th><th>Licence</th><th>Category</th>
    <th>Posture</th><th>Rule applied</th><th>Obligations</th>
  </tr></thead>
  <tbody>
  {% for c in risk_register %}
    <tr>
      <td>{{ c.name }}</td>
      <td>{{ c.version or "—" }}</td>
      <td class="mono">{{ c.license_expression or "(unresolved)" }}</td>
      <td>{{ c.categories | join(", ") if c.categories else "—" }}</td>
      <td>
        <span class="badge {{ c.posture }}">{{ c.posture | posture_label }}</span>
        {% if c.exception %}<div class="applies">exception applied (was {{ c.base_posture | posture_label }})</div>{% endif %}
      </td>
      <td class="mono">{{ c.rules_applied | join("; ") if c.rules_applied else "—" }}</td>
      <td>{{ c.obligations | join("; ") if c.obligations else "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Unresolved and unknown components</h2>
{% if unresolved %}
<p>These could not be resolved to a known licence and were given the policy's conservative default. They need human attention before distribution.</p>
<table>
  <thead><tr><th>Component</th><th>Version</th><th>Posture</th><th>Reason</th></tr></thead>
  <tbody>
  {% for u in unresolved %}
    <tr><td>{{ u.name }}</td><td>{{ u.version or "—" }}</td>
      <td><span class="badge {{ u.posture }}">{{ u.posture | posture_label }}</span></td>
      <td>{{ u.reason }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p>None. Every component resolved to a known licence.</p>
{% endif %}

<h2>Obligations to satisfy before distribution</h2>
{% if obligations %}
<p>The following obligations arise from the components above. Satisfying them is necessary but not by itself sufficient; see the disclaimer.</p>
<ul class="tight">
  {% for item in obligations %}
  <li>{{ item.obligation }}<div class="applies">Applies to: {{ item.components | join(", ") }}</div></li>
  {% endfor %}
</ul>
{% else %}
<p>No specific obligations were derived. Standard good practice still applies.</p>
{% endif %}

<h2>Exceptions applied</h2>
{% if exceptions_applied %}
<table>
  <thead><tr><th>Component</th><th>Version</th><th>Override</th><th>Was</th><th>Justification</th><th>Owner</th><th>Date</th></tr></thead>
  <tbody>
  {% for e in exceptions_applied %}
    <tr>
      <td>{{ e.component }}</td><td>{{ e.version }}</td>
      <td><span class="badge {{ e.override_posture }}">{{ e.override_posture | posture_label }}</span></td>
      <td><span class="badge {{ e.original_posture }}">{{ e.original_posture | posture_label }}</span></td>
      <td>{{ e.justification }}</td><td>{{ e.owner }}</td><td>{{ e.date }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p>No exceptions were applied.</p>
{% endif %}

{% if vulnerabilities is defined %}
<h2>Vulnerabilities reported in the SBOM (informational)</h2>
<p class="muted">This section reproduces vulnerability data already present in the SBOM. It is not generated or verified by this tool and is separate from licence analysis.</p>
{% if vulnerabilities %}
<table>
  <thead><tr><th>Component</th><th>Version</th><th>ID</th><th>Severity</th><th>Source</th></tr></thead>
  <tbody>
  {% for v in vulnerabilities %}
    {% for entry in v.vulnerabilities %}
    <tr><td>{{ v.name }}</td><td>{{ v.version or "—" }}</td><td class="mono">{{ entry.id }}</td>
      <td>{{ entry.severity or "—" }}</td><td>{{ entry.source or "—" }}</td></tr>
    {% endfor %}
  {% endfor %}
  </tbody>
</table>
{% else %}
<p>No vulnerability data was present in the SBOM.</p>
{% endif %}
{% endif %}

<h2>Methodology</h2>
<ul class="tight">
  {% for paragraph in methodology %}<li>{{ paragraph }}</li>{% endfor %}
</ul>

<h2>Known limitations</h2>
<ul class="tight">
  {% for limitation in limitations %}<li>{{ limitation }}</li>{% endfor %}
</ul>

<h2>Disclaimer</h2>
<p>{{ disclaimer }}</p>

<footer>
  Report schema {{ report_schema_version }}. Generated by {{ tool.name }} {{ tool.version }}.
  Classifications follow the policy named above and are indicative only.
</footer>

</body>
</html>
